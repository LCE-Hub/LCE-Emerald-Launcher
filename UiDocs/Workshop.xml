  <view id="workshop">
    <tooltip icon="A">{{t:common.select}}</tooltip>
    <tooltip icon="B" action="@back">{{t:common.back}}</tooltip>
    <column width="1280px" height="720px" align="center" padding="40">
      <row class="ws-tabs">
        <button class="ws-tab {{tabSkinClass}}" onclick="workshop.tab:Skin">
          <label class="ws-tab-text" text="{{t:workshop.tabs.skin}}"/>
        </button>
        <button class="ws-tab {{tabTextureClass}}" onclick="workshop.tab:Texture">
          <label class="ws-tab-text" text="{{t:workshop.tabs.texture}}"/>
        </button>
        <button class="ws-tab {{tabWorldClass}}" onclick="workshop.tab:World">
          <label class="ws-tab-text" text="{{t:workshop.tabs.world}}"/>
        </button>
        <button class="ws-tab {{tabModClass}}" onclick="workshop.tab:Mod">
          <label class="ws-tab-text" text="{{t:workshop.tabs.mod}}"/>
        </button>
        <button class="ws-tab {{tabDlcClass}}" onclick="workshop.tab:DLC">
          <label class="ws-tab-text" text="{{t:workshop.tabs.dlc}}"/>
        </button>
        <button class="ws-tab {{tabVersionsClass}}" onclick="workshop.tab:Versions">
          <label class="ws-tab-text" text="{{t:workshop.tabs.versions}}"/>
        </button>
        <button class="ws-tab {{tabInstalledClass}}" onclick="workshop.tab:Installed">
          <label class="ws-tab-text" text="{{t:workshop.tabs.installed}}"/>
        </button>
        <button class="ws-tab {{tabSearchClass}}" onclick="workshop.tab:Search">
          <label class="ws-tab-text" text="{{t:workshop.tabs.search}}"/>
        </button>
        <button class="ws-tab {{tabServerClass}}" onclick="workshop.tab:Server">
          <label class="ws-tab-text" text="{{t:workshop.tabs.server}}"/>
        </button>
      </row>
      <column class="optionsbg" padding="6" width="1200px" height="580px" align="center">
        <column if="{{loading}}" class="ws-empty">
          <label class="ws-loading" text="{{t:workshop.searchingArchives}}"/>
        </column>
        <column if="{{hasError}}" class="ws-empty">
          <label class="ws-error-label" text="{{error}}"/>
        </column>
        <column if="{{showSearchTabPrompt}}" class="ws-empty">
          <label class="ws-empty-label" text="{{t:workshop.startTypingToSearch}}"/>
        </column>
        <column if="{{showContent}}" width="100%" height="528px" gap="6px">
          <row if="{{showSearch}}" class="ws-toolbar">
            <textinput id="workshop-search" class="ws-filter" value="{{search}}" onsubmit="workshop.search" label="{{searchLabel}}"/>
            <button if="{{hasSearch}}" class="ws-clear" onclick="workshop.search.clear">
              <label text="X"/>
            </button>
          </row>
          <row if="{{showServerCategories}}" class="ws-cat-bar">
            <button foreach="{{serverCategories}}" as="cat" class="ws-cat {{cat.cls}}" onclick="{{cat.action}}">
              <label class="ws-cat-text" text="{{cat.label}}"/>
            </button>
          </row>
          <scroll class="ws-recess" width="100%" height="530px" hide-partial="true">
            <column class="ws-grid">
              <column if="{{showBulkActions}}" width="100%" gap="0px">
                <row class="ws-bulk-row">
                  <button class="ws-bulk ws-bulk-update" onclick="workshop.updateAll">
                    <label text="{{updateAllLabel}}"/>
                  </button>
                  <button class="ws-bulk" onclick="workshop.reinstallAll">
                    <label text="{{reinstallAllLabel}}"/>
                  </button>
                </row>
                <column class="ws-divider-dark"/>
              </column>
              <column if="{{noItems}}" class="ws-empty">
                <label class="ws-empty-label" text="{{emptyMessage}}"/>
              </column>
              <row foreach="{{rows}}" as="row" class="ws-grid-row">
                <column if="{{row.has0}}" class="ws-card" onclick="{{row.c0.action}}">
                  <column class="ws-card-thumb-wrap">
                    <image if="{{row.c0.hasThumb}}" class="ws-card-thumb" src="{{row.c0.thumb}}" fit="cover"/>
                    <column if="{{row.c0.noThumb}}" class="ws-card-noimage">
                      <label class="ws-card-noimage-text" text="{{row.c0.noImageLabel}}"/>
                    </column>
                    <row if="{{row.c0.badge}}" class="ws-chip ws-chip-cat">
                      <label class="ws-upper" text="{{row.c0.badge}}"/>
                    </row>
                    <row if="{{row.c0.update}}" class="ws-chip ws-chip-update">
                      <label class="ws-upper" text="{{row.c0.updateLabel}}"/>
                    </row>
                    <row if="{{row.c0.showInstalled}}" class="ws-chip ws-chip-installed">
                      <label class="ws-upper" text="{{row.c0.installedLabel}}"/>
                    </row>
                  </column>
                  <column class="ws-card-body">
                    <label class="ws-card-name" text="{{row.c0.name}}"/>
                    <row class="ws-card-meta">
                      <label class="ws-card-version" text="v{{row.c0.version}}"/>
                      <label class="ws-card-author" text="{{row.c0.author}}"/>
                    </row>
                    <label class="ws-card-desc" text="{{row.c0.desc}}"/>
                    <column class="ws-card-focus"/>
                  </column>
                </column>
                <column if="{{row.has1}}" class="ws-card" onclick="{{row.c1.action}}">
                  <column class="ws-card-thumb-wrap">
                    <image if="{{row.c1.hasThumb}}" class="ws-card-thumb" src="{{row.c1.thumb}}" fit="cover"/>
                    <column if="{{row.c1.noThumb}}" class="ws-card-noimage">
                      <label class="ws-card-noimage-text" text="{{row.c1.noImageLabel}}"/>
                    </column>
                    <row if="{{row.c1.badge}}" class="ws-chip ws-chip-cat">
                      <label class="ws-upper" text="{{row.c1.badge}}"/>
                    </row>
                    <row if="{{row.c1.update}}" class="ws-chip ws-chip-update">
                      <label class="ws-upper" text="{{row.c1.updateLabel}}"/>
                    </row>
                    <row if="{{row.c1.showInstalled}}" class="ws-chip ws-chip-installed">
                      <label class="ws-upper" text="{{row.c1.installedLabel}}"/>
                    </row>
                  </column>
                  <column class="ws-card-body">
                    <label class="ws-card-name" text="{{row.c1.name}}"/>
                    <row class="ws-card-meta">
                      <label class="ws-card-version" text="v{{row.c1.version}}"/>
                      <label class="ws-card-author" text="{{row.c1.author}}"/>
                    </row>
                    <label class="ws-card-desc" text="{{row.c1.desc}}"/>
                    <column class="ws-card-focus"/>
                  </column>
                </column>
                <column if="{{row.has2}}" class="ws-card" onclick="{{row.c2.action}}">
                  <column class="ws-card-thumb-wrap">
                    <image if="{{row.c2.hasThumb}}" class="ws-card-thumb" src="{{row.c2.thumb}}" fit="cover"/>
                    <column if="{{row.c2.noThumb}}" class="ws-card-noimage">
                      <label class="ws-card-noimage-text" text="{{row.c2.noImageLabel}}"/>
                    </column>
                    <row if="{{row.c2.badge}}" class="ws-chip ws-chip-cat">
                      <label class="ws-upper" text="{{row.c2.badge}}"/>
                    </row>
                    <row if="{{row.c2.update}}" class="ws-chip ws-chip-update">
                      <label class="ws-upper" text="{{row.c2.updateLabel}}"/>
                    </row>
                    <row if="{{row.c2.showInstalled}}" class="ws-chip ws-chip-installed">
                      <label class="ws-upper" text="{{row.c2.installedLabel}}"/>
                    </row>
                  </column>
                  <column class="ws-card-body">
                    <label class="ws-card-name" text="{{row.c2.name}}"/>
                    <row class="ws-card-meta">
                      <label class="ws-card-version" text="v{{row.c2.version}}"/>
                      <label class="ws-card-author" text="{{row.c2.author}}"/>
                    </row>
                    <label class="ws-card-desc" text="{{row.c2.desc}}"/>
                    <column class="ws-card-focus"/>
                  </column>
                </column>
                <column if="{{row.has3}}" class="ws-card" onclick="{{row.c3.action}}">
                  <column class="ws-card-thumb-wrap">
                    <image if="{{row.c3.hasThumb}}" class="ws-card-thumb" src="{{row.c3.thumb}}" fit="cover"/>
                    <column if="{{row.c3.noThumb}}" class="ws-card-noimage">
                      <label class="ws-card-noimage-text" text="{{row.c3.noImageLabel}}"/>
                    </column>
                    <row if="{{row.c3.badge}}" class="ws-chip ws-chip-cat">
                      <label class="ws-upper" text="{{row.c3.badge}}"/>
                    </row>
                    <row if="{{row.c3.update}}" class="ws-chip ws-chip-update">
                      <label class="ws-upper" text="{{row.c3.updateLabel}}"/>
                    </row>
                    <row if="{{row.c3.showInstalled}}" class="ws-chip ws-chip-installed">
                      <label class="ws-upper" text="{{row.c3.installedLabel}}"/>
                    </row>
                  </column>
                  <column class="ws-card-body">
                    <label class="ws-card-name" text="{{row.c3.name}}"/>
                    <row class="ws-card-meta">
                      <label class="ws-card-version" text="v{{row.c3.version}}"/>
                      <label class="ws-card-author" text="{{row.c3.author}}"/>
                    </row>
                    <label class="ws-card-desc" text="{{row.c3.desc}}"/>
                    <column class="ws-card-focus"/>
                  </column>
                </column>
              </row>
            </column>
          </scroll>
        </column>
      </column>
      <column class="ws-backdrop" if="{{modalOpen}}" align="center" justify="center" style="position:absolute;left:0px;top:0px;width:1280px;height:720px" onclick="workshop.close">
        <column id="workshop-modal" class="ws-modal-main" onclick="workshop.modal.block">
          <column class="ws-modal-head">
            <image if="{{modal.hasThumb}}" class="ws-modal-thumb" src="{{modal.thumb}}" fit="cover"/>
            <column if="{{modal.noThumb}}" class="ws-modal-noimage">
              <label class="ws-modal-noimage-text" text="{{modal.noImageLabel}}"/>
            </column>
            <column class="ws-modal-shade"/>
            <column class="ws-modal-caption">
              <label class="ws-modal-name" text="{{modal.name}}"/>
              <label class="ws-modal-by" text="{{modal.byAuthor}}"/>
            </column>
            <row if="{{modal.needsUpdate}}" class="ws-modal-flag ws-modal-flag-update">
              <label class="ws-upper" text="{{modal.updateAvailableBadge}}"/>
            </row>
            <row if="{{modal.showInstalledBadge}}" class="ws-modal-flag ws-modal-flag-installed">
              <label class="ws-upper" text="{{modal.installedBadge}}"/>
            </row>
            <row if="{{modal.showSavedBadge}}" class="ws-modal-flag ws-modal-flag-installed">
              <label class="ws-upper" text="{{modal.savedBadge}}"/>
            </row>
          </column>
          <column class="ws-modal-body">
            <scroll class="ws-modal-scroll">
              <column class="ws-modal-content">
                <label if="{{modal.desc}}" class="ws-modal-desc" text="{{modal.desc}}"/>
                <column if="{{modal.hasExtended}}" class="ws-modal-extended">
                  <label class="ws-modal-extended-head" text="{{modal.detailsLabel}}"/>
                  <label class="ws-modal-extended-text" text="{{modal.extended}}"/>
                </column>
                <column class="ws-divider-soft"/>
                <row class="ws-modal-meta-grid">
                  <column if="{{modal.isServer}}" class="ws-modal-meta-col">
                    <label class="ws-modal-meta-head" text="{{modal.metadataLabel}}"/>
                    <row class="ws-modal-meta-row">
                      <label class="ws-modal-meta-label" text="{{modal.addressLabel}}"/>
                      <label class="ws-meta-value-ok" text="{{modal.serverAddress}}"/>
                    </row>
                    <row class="ws-modal-meta-row">
                      <label class="ws-modal-meta-label" text="{{modal.typeLabel}}"/>
                      <label class="ws-modal-meta-value" text="{{modal.serverType}}"/>
                    </row>
                    <row class="ws-modal-meta-row">
                      <label class="ws-modal-meta-label" text="{{modal.versionLabel}}"/>
                      <label class="ws-modal-meta-value" text="v{{modal.serverVersion}}"/>
                    </row>
                    <row class="ws-modal-meta-row">
                      <label class="ws-modal-meta-label" text="{{modal.ownerLabel}}"/>
                      <label class="ws-modal-meta-value" text="{{modal.serverOwner}}"/>
                    </row>
                    <row if="{{modal.hasDiscord}}" class="ws-modal-meta-row">
                      <label class="ws-modal-meta-label" text="{{modal.discordLabel}}"/>
                      <label class="ws-meta-value-ok" text="{{modal.serverDiscord}}"/>
                    </row>
                  </column>
                  <column if="{{modal.isVersion}}" class="ws-modal-meta-col">
                    <label class="ws-modal-meta-head" text="{{modal.metadataLabel}}"/>
                    <row class="ws-modal-meta-row">
                      <label class="ws-modal-meta-label" text="{{modal.versionLabel}}"/>
                      <label class="ws-modal-meta-value" text="v{{modal.version}}"/>
                    </row>
                    <row class="ws-modal-meta-row">
                      <label class="ws-modal-meta-label" text="{{modal.packageIdLabel}}"/>
                      <label class="ws-meta-value-ok" text="{{modal.packageId}}"/>
                    </row>
                  </column>
                  <column if="{{modal.isContent}}" class="ws-modal-meta-col">
                    <label class="ws-modal-meta-head" text="{{modal.metadataLabel}}"/>
                    <row class="ws-modal-meta-row">
                      <label class="ws-modal-meta-label" text="{{modal.versionLabel}}"/>
                      <label class="ws-modal-meta-value" text="v{{modal.version}}"/>
                    </row>
                    <row class="ws-modal-meta-row">
                      <label class="ws-modal-meta-label" text="{{modal.packageIdLabel}}"/>
                      <label class="ws-meta-value-ok" text="{{modal.packageId}}"/>
                    </row>
                    <row if="{{modal.hasInstalled}}" class="ws-modal-meta-row">
                      <label class="ws-modal-meta-label" text="{{modal.installedLabel}}"/>
                      <label class="{{modal.installedVersionCls}}" text="v{{modal.installedVersion}}{{modal.outdatedLabel}}"/>
                    </row>
                  </column>
                  <column class="ws-modal-meta-col">
                    <label class="ws-modal-meta-head-alt" text="{{modal.categoriesLabel}}"/>
                    <row foreach="{{modal.categories}}" as="cat" class="ws-modal-chip">
                      <label class="ws-upper" text="{{cat}}"/>
                    </row>
                  </column>
                </row>
                <column if="{{modal.hasDependencies}}" class="ws-modal-section">
                  <column class="ws-divider-dark"/>
                  <label class="ws-modal-deps-head" text="{{t:workshop.requiredDependencies}}"/>
                  <row foreach="{{modal.dependencies}}" as="dep" class="ws-modal-chip {{dep.cls}}">
                    <label class="ws-upper" text="{{dep.label}}"/>
                  </row>
                </column>
                <column if="{{modal.hasRequiredEditions}}" class="ws-modal-section">
                  <column class="ws-divider-dark"/>
                  <label class="ws-modal-eds-head" text="{{t:workshop.requiredEditions}}"/>
                  <row foreach="{{modal.requiredEditions}}" as="req" class="ws-modal-eds-text">
                    <label class="ws-upper" text="{{req.name}}"/>
                  </row>
                </column>
                <column if="{{modal.hasFiles}}" class="ws-modal-section">
                  <column class="ws-divider-dark"/>
                  <label class="ws-modal-files-head" text="{{modal.filesLabel}}"/>
                  <column class="ws-modal-file-list">
                    <column foreach="{{modal.files}}" as="file" class="ws-modal-file">
                      <row class="ws-card-meta">
                        <label class="ws-modal-file-main" text="{{file.main}}"/>
                        <row if="{{file.split}}" class="ws-modal-file-split">
                          <label class="ws-upper" text="{{file.splitLabel}}"/>
                        </row>
                        <label if="{{file.dest}}" class="ws-modal-file-dest" text="{{file.dest}}"/>
                      </row>
                      <label if="{{file.split}}" class="ws-modal-file-parts" text="{{file.parts}}"/>
                    </column>
                  </column>
                </column>
              </column>
            </scroll>
            <row class="ws-modal-actions">
              <button class="ws-mbtn ws-mbtn-install" onclick="{{modal.installAction}}">
                <label text="{{modal.installLabel}}"/>
              </button>
              <button if="{{modal.hasInstalled}}" class="ws-mbtn ws-mbtn-remove" onclick="workshop.uninstall.open">
                <label text="{{modal.removeLabel}}"/>
              </button>
              <button class="ws-mbtn ws-mbtn-back" onclick="workshop.close">
                <label text="{{modal.backLabel}}"/>
              </button>
            </row>
          </column>
        </column>
      </column>
      <column class="ws-backdrop" if="{{depsOpen}}" align="center" justify="center" style="position:absolute;left:0px;top:0px;width:1280px;height:720px" onclick="workshop.close">
        <column id="workshop-deps" class="ws-modal-small ws-modal-deps" onclick="workshop.modal.block">
          <column class="ws-sm-head">
            <label class="ws-sm-title-deps" text="{{depsTitle}}"/>
            <label class="ws-sm-sub" text="{{depsSubtitle}}"/>
          </column>
          <column class="ws-divider-strong"/>
          <scroll width="100%" height="276px">
            <column class="ws-sm-list">
              <row foreach="{{unresolvedDeps}}" as="dep" class="ws-dep-row">
                <label class="ws-dep-name" text="{{dep.name}}"/>
                <label class="ws-dep-version" text="v{{dep.version}}"/>
              </row>
              <label class="ws-dep-note" text="{{depsNote}}"/>
            </column>
          </scroll>
          <column class="ws-divider-strong"/>
          <row class="ws-sm-footer">
            <button class="ws-sm-btn" onclick="workshop.deps.cancel">
              <label text="{{cancelLabel}}"/>
            </button>
            <button class="ws-sm-btn ws-sm-btn-install" onclick="workshop.deps.confirm">
              <label text="{{t:workshop.install}}"/>
            </button>
          </row>
        </column>
      </column>
      <column class="ws-backdrop" if="{{installOpen}}" align="center" justify="center" style="position:absolute;left:0px;top:0px;width:1280px;height:720px" onclick="workshop.close">
        <column id="workshop-install" class="ws-modal-small ws-modal-install" onclick="workshop.modal.block">
          <column class="ws-sm-head">
            <label class="ws-sm-title" text="{{installTitle}}"/>
            <label class="ws-sm-sub" text="{{installSubtitle}}"/>
          </column>
          <column class="ws-divider-strong"/>
          <scroll width="100%" height="294px">
            <column class="ws-sm-list">
              <column if="{{installBusy}}" class="ws-state">
                <label class="ws-state-title-install" text="{{installingLabel}}"/>
                <label if="{{installHasDeps}}" class="ws-state-sub" text="{{downloadingDepsLabel}}"/>
                <label if="{{installHasNoDeps}}" class="ws-state-sub" text="{{downloadingLabel}}"/>
                <row class="ws-progress-row">
                  <label class="ws-progress-label" text="{{jobLabel}}"/>
                  <label class="ws-progress-pct" text="{{jobPercent}}%"/>
                </row>
                <row class="ws-progress">
                  <column class="ws-progress-fill" style="width:{{jobPercent}}%"/>
                </row>
                <row if="{{installHasDeps}}" class="ws-dep-chips">
                  <row foreach="{{modal.dependencies}}" as="dep" class="ws-chip-pending">
                    <label class="ws-upper" text="{{dep.name}}"/>
                  </row>
                </row>
              </column>
              <column if="{{installDone}}" class="ws-state">
                <label class="ws-state-title-success" text="{{installedOkLabel}}"/>
                <label class="ws-state-sub" text="{{pressKeyLabel}}"/>
              </column>
              <column if="{{installHasError}}" class="ws-state">
                <label class="ws-state-title-error" text="{{installFailedLabel}}"/>
                <label class="ws-state-sub" text="{{installError}}"/>
                <button class="ws-retry" onclick="workshop.install.retry">
                  <label text="{{retryLabel}}"/>
                </button>
              </column>
              <column if="{{installReady}}" width="100%" gap="8px">
                <column if="{{noTargets}}" class="ws-empty" height="120px">
                  <label class="ws-state-title-error" text="{{noTargetsLabel}}"/>
                </column>
                <row foreach="{{installTargets}}" as="target" class="ws-target {{target.cls}}" onclick="workshop.install.target:{{target.id}}">
                  <label class="ws-target-name" text="{{target.name}}"/>
                </row>
              </column>
            </column>
          </scroll>
        </column>
      </column>
      <column class="ws-backdrop" if="{{uninstallOpen}}" align="center" justify="center" style="position:absolute;left:0px;top:0px;width:1280px;height:720px" onclick="workshop.close">
        <column id="workshop-uninstall" class="ws-modal-small ws-modal-uninstall" onclick="workshop.modal.block">
          <column class="ws-sm-head">
            <label class="ws-sm-title-danger" text="{{uninstallTitle}}"/>
            <label class="ws-sm-sub" text="{{uninstallSubtitle}}"/>
          </column>
          <column class="ws-divider-strong"/>
          <scroll width="100%" height="294px">
            <column class="ws-sm-list">
              <column if="{{uninstallBusy}}" class="ws-state">
                <label class="ws-state-title-error" text="{{removingLabel}}"/>
                <label class="ws-state-sub" text="{{deletingLabel}}"/>
              </column>
              <column if="{{uninstallDone}}" class="ws-state">
                <label class="ws-state-title-success" text="{{removedLabel}}"/>
                <label class="ws-state-sub" text="{{pressKeyLabel}}"/>
              </column>
              <column if="{{uninstallHasError}}" class="ws-state">
                <label class="ws-state-title-error" text="{{removalFailedLabel}}"/>
                <label class="ws-state-sub" text="{{uninstallError}}"/>
                <button class="ws-retry" onclick="workshop.uninstall.retry">
                  <label text="{{retryLabel}}"/>
                </button>
              </column>
              <column if="{{uninstallReady}}" width="100%" gap="8px">
                <row foreach="{{uninstallList}}" as="entry" class="ws-target ws-target-danger {{entry.cls}}" onclick="workshop.uninstall.target:{{entry.id}}">
                  <label class="ws-target-name" text="{{entry.name}}"/>
                  <label class="ws-target-version" text="v{{entry.version}}"/>
                </row>
              </column>
            </column>
          </scroll>
        </column>
      </column>
    </column>
  </view>
</ui>
